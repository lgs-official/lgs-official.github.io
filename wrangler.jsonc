{
  "name": "lgs-official",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "lgsofficial.com", "custom_domain": true },
    { "pattern": "www.lgsofficial.com", "custom_domain": true }
  ]
}
